PORT=3002
DATABASE_URL=postgres://usuario:clave@host:5432/marketing
# Login: el mismo Supabase de los otros paneles (Conversaciones, Cotizaciones, Cobranzas)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_KEY=
# Token de Higgsfield (solo para sembrar la BD la primera vez; luego rota y vive en la tabla hf_token)
HF_CLIENT_ID=
HF_REFRESH_TOKEN=
# Worker (opcionales)
WORKER_POLL_MS=4000
WORKER_TIMEOUT_MIN=45
# Redes sociales (Zernio). Sin la key, la pestaña Redes queda como "no configurada".
ZERNIO_API_KEY=
# Opcionales: perfil fijo de Zernio y URL publica del panel (para volver tras conectar una cuenta)
ZERNIO_PROFILE_ID=
PANEL_URL=
# Prompt automatico desde la imagen (OpenAI Responses API). MODELO_PROMPT opcional, gpt-4.1 por defecto.
OPENAI_API_KEY=
MODELO_PROMPT=
# Webhook de Zernio (secreto HMAC propio) y URL publica del panel (retorno de OAuth y registro del webhook)
ZERNIO_WEBHOOK_SECRET=
# PANEL_URL ya esta arriba
# Clasificacion automatica de plantillas nuevas (worker; usa OPENAI_API_KEY). Opcional:
MODELO_CLASIFICAR=
