PORT=3002
DATABASE_URL=postgres://usuario:clave@host:5432/marketing
# Login del panel: correo:hash separados por coma. Hash con: npm run hash-password
SESSION_SECRET=
PANEL_USUARIOS=
# Token de Higgsfield (solo para sembrar la BD la primera vez; luego rota y vive en la tabla hf_token)
HF_CLIENT_ID=
HF_REFRESH_TOKEN=
# 1 = mostrar el saldo de creditos en el panel (en standby)
CREDITOS_VISIBLES=0
# Worker (opcionales)
WORKER_POLL_MS=4000
WORKER_TIMEOUT_MIN=45
# Redes sociales (Zernio). Sin la key, la pestaña Redes queda como "no configurada".
ZERNIO_API_KEY=
# Opcionales: perfil fijo de Zernio y URL publica del panel (para volver tras conectar una cuenta)
ZERNIO_PROFILE_ID=
PANEL_URL=
